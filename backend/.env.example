# Copy this file to .env, fill in your keys, and never commit .env.

# Google Gemini — for the AI chat assistant
# Free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenRouteService — for real road distance, duration and geocoding
# Free key at https://openrouteservice.org (2000 requests/day free)
ORS_API_KEY=your_ors_api_key_here
